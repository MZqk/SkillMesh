{
  "name": "skillmesh",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Native MCP App for local Skill mapping, human confirmation, controlled installation, and ui/message handoff.",
  "scripts": {
    "mcp": "node mcp-server.mjs",
    "build:app": "node scripts/build-app.mjs",
    "check:app": "node scripts/build-app.mjs --check",
    "build:plugin": "node scripts/build-plugin-runtime.mjs",
    "check:plugin": "node scripts/build-plugin-runtime.mjs --check",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "setup:pdf": "node scripts/setup-pdf.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
